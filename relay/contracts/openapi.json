                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics",
        "description": "Private fixed-vocabulary process counters and timing sums. No user/source/session labels; fewer than 64 series and 8192 output bytes.",
        "security": [
          {
            "ControlBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Prometheus text exposition",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "maxLength": 8192
                }
