{
  "openapi": "3.1.0",
  "info": {
    "title": "Family Stream Relay",
    "version": "relay.v1",
    "description": "Implemented relay.v1 private control/health and independently authorized stream listeners. Runtime readiness is distinct from live/player/deployment acceptance."
  },
  "x-design-status": "implemented-offline-verified-live-acceptance-pending",
  "tags": [
    {
      "name": "control"
    },
    {
      "name": "stream"
    }
  ],
  "paths": {
    "/internal/v1/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "Durably import a provider selection",
        "security": [
          {
            "ControlBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./relay.schema.json#/$defs/CreateSession"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session persisted; entry_path has no grant or upstream URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/SessionReady"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay of the same request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/SessionReady"
                }
              }
            }
          },
          "default": {
            "description": "Safe pre-body error, never raw upstream context",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/sessions/{session_id}": {
      "parameters": [
        {
          "name": "session_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 22,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "get": {
        "operationId": "getSession",
        "security": [
          {
            "ControlBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted session state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/SessionReady"
                }
              }
            }
          },
          "default": {
            "description": "Safe pre-body error, never raw upstream context",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "revokeSession",
        "description": "Authenticated control caller revokes by opaque SID; persist tombstone and cancel active requests. Repeated deletion is safe.",
        "security": [
          {
            "ControlBearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked or already absent"
          },
          "default": {
            "description": "Safe pre-body error, never raw upstream context",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/sessions/{session_id}/renew": {
      "parameters": [
        {
          "name": "session_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
