      "post": {
        "operationId": "renewSession",
        "security": [
          {
            "ControlBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./relay.schema.json#/$defs/RenewSession"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CAS state transition; source change requires caller reload/resume",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/SessionReady"
                }
              }
            }
          },
          "default": {
            "description": "Safe pre-body error, never raw upstream context",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/sessions/{session_id}/source": {
      "parameters": [
        {
          "name": "session_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 22,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "post": {
        "operationId": "sourceSession",
        "security": [
          {
            "ControlBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./relay.schema.json#/$defs/UpdateSource"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CAS state transition; source change requires caller reload/resume",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/SessionReady"
                }
              }
            }
          },
          "default": {
            "description": "Safe pre-body error, never raw upstream context",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "description": "Prepare a fresh matching selection via guarded HLS graph or MP4 prefix validation; atomically publish generation/resources under expected revision. The API obtains selections from providers; relay makes no provider call."
      }
    },
    "/internal/v1/sessions/{session_id}/failover": {
      "parameters": [
        {
          "name": "session_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 22,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "post": {
        "operationId": "failoverSession",
        "security": [
          {
            "ControlBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./relay.schema.json#/$defs/MutationBase"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CAS state transition; source change requires caller reload/resume",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/SessionReady"
                }
              }
            }
          },
          "default": {
            "description": "Safe pre-body error, never raw upstream context",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "description": "Prepare stored backups in original order within finite time/byte/state limits; atomically activate the first successful candidate. No automatic entry/segment switching. A stale revision returns 409; read current state before an intentional next mutation."
      }
    },
