    "/health/livez": {
      "get": {
        "operationId": "livez",
        "description": "Private control-listener health only; never exposed through Serve.",
        "security": [
          {
            "ControlBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/Health"
                }
              }
            }
          },
          "503": {
            "description": "Not ready/draining",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./relay.schema.json#/$defs/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/readyz": {
      "get": {
        "operationId": "readyz",
        "description": "Private authenticated runtime readiness: store/key owner, current VPN epoch, task owner, admission and drain state. No upstream-media health request. Provider readiness is external; overall acceptance remains false.",
        "security": [
          {
            "ControlBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
