{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-stream.invalid/contracts/relay.schema.json",
  "title": "Family Stream relay.v1 contract",
  "description": "Implemented private control and stream contract. Cross-field authorization, title identity, guarded egress, expiry and resource limits also require runtime validation.",
  "$ref": "#/$defs/CreateSession",
  "$defs": {
    "CreateSession": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "relay.v1"
        },
        "owner_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "selection": {
          "allOf": [
            {
              "$ref": "providers.schema.json#/$defs/Selection"
            },
            {
              "type": "object",
              "required": [
                "selected"
              ],
              "properties": {
                "selected": {
                  "$ref": "providers.schema.json#/$defs/Ranked"
                },
                "backups": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "maxItems": 127
                }
              }
            }
          ]
        }
      },
      "required": [
        "contract_version",
        "owner_id",
        "expires_at",
        "selection"
      ],
      "additionalProperties": false
    },
    "SessionReady": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "relay.v1"
        },
        "session_id": {
          "type": "string"
        },
        "entry_path": {
          "type": "string",
          "pattern": "^/stream/[A-Za-z0-9_-]+/entry$"
        },
        "format": {
          "enum": [
            "hls",
            "mp4"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "source_generation": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "active",
            "draining",
            "expired",
            "revoked"
          ]
        },
        "resume_required": {
          "type": "boolean"
        },
        "auth_revision": {
          "type": "integer",
          "minimum": 1
        },
        "available_heights": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "contract_version",
        "session_id",
        "entry_path",
        "format",
        "expires_at",
        "revision",
        "source_generation",
        "state",
        "auth_revision"
      ],
      "additionalProperties": false
    },
    "MutationBase": {
      "type": "object",
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "owner_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "RenewSession": {
      "type": "object",
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "owner_id",
        "expected_revision",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "UpdateSource": {
      "type": "object",
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "selection": {
          "allOf": [
            {
              "$ref": "providers.schema.json#/$defs/Selection"
            },
            {
              "type": "object",
              "required": [
                "selected"
              ],
              "properties": {
                "selected": {
                  "$ref": "providers.schema.json#/$defs/Ranked"
                },
                "backups": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "maxItems": 127
                }
              }
            }
          ]
        }
      },
      "required": [
        "owner_id",
        "expected_revision",
        "selection"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "detail",
        "request_id",
        "retryable"
      ],
      "additionalProperties": false
    },
    "Health": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "alive",
            "ready",
            "not_ready",
            "draining"
          ]
        },
        "contract_version": {
          "const": "relay.v1"
        },
        "store_keys": {
          "type": "boolean"
        },
        "transport_epoch": {
          "type": "boolean"
        },
        "admission": {
          "type": "boolean"
        },
        "owned_tasks": {
          "type": "boolean"
        },
        "provider_readiness": {
          "const": "external"
        },
        "overall_acceptance": {
          "const": false
        }
      },
      "required": [
        "status",
        "contract_version"
      ],
      "additionalProperties": false
    },
    "UpdateBackups": {
      "type": "object",
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "selection": {
          "allOf": [
            {
              "$ref": "providers.schema.json#/$defs/Selection"
            },
            {
              "type": "object",
              "required": [
                "selected"
              ],
              "properties": {
                "selected": {
                  "$ref": "providers.schema.json#/$defs/Ranked"
                },
                "backups": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "maxItems": 127
                }
              }
            }
          ]
        },
        "expected_generation": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "owner_id",
        "expected_generation",
        "selection"
      ],
      "additionalProperties": false
    }
  }
}
