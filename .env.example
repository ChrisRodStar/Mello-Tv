# ---- Required ----------------------------------------------------------

# Address Jellyfin and its apps use to reach Mello. Written into every .strm
# file, so use something every client can reach (LAN IP, or Tailscale IP/name).
MELLO_PUBLIC_URL=http://192.168.1.50:8080

# Free TMDB key: https://www.themoviedb.org/settings/api (either one works)
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# ---- Recommended -------------------------------------------------------

# Owner of the generated files. Match the user Jellyfin runs as.
PUID=1000
PGID=1000

# Let Mello tell Jellyfin to rescan after each library change.
# Jellyfin: Dashboard -> API Keys -> +
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# ---- Optional ----------------------------------------------------------

# Admin key for the /api endpoints. Leave empty to auto-generate data/api-key.
MELLO_API_KEY=

# Highest quality to look for: 720, 1080 or 2160.
MELLO_MAX_HEIGHT=1080

# Preferred audio languages, most preferred first (ISO codes).
MELLO_AUDIO_LANGUAGES=en

# Send provider and stream traffic through a proxy/VPN container,
# e.g. socks5://gluetun:1080 or http://gluetun:8888
MELLO_PROXY=

# Auto-filled collections: trending_movies, trending_tv, popular_movies,
# popular_tv, top_rated_movies, top_rated_tv, each with an optional :count.
MELLO_AUTO_LISTS=
# Public TMDB list IDs to mirror (manage them in the TMDB app or website).
MELLO_TMDB_LISTS=

# Hours between automatic re-syncs (picks up new episodes).
MELLO_SYNC_INTERVAL_HOURS=6
# Include "Season 00" specials.
MELLO_INCLUDE_SPECIALS=false
