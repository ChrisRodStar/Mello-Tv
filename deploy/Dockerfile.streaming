#
#  Dockerfile.streaming
#  Stream TV Deployment
#
#  Created by ChrisRodStar.
#
#  Summary:
#  Production container definition packaging the Go provider resolver, Rust media relay,
#  WireGuard tools, iptables firewall, and supervisord inside an isolated network namespace.
#

FROM debian:bookworm-slim

# Install networking utilities, WireGuard, firewall tools, and process supervisor
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        iproute2 \
        iptables \
        python3 \
        supervisor \
        util-linux \
        wireguard-tools && \
    rm -rf /var/lib/apt/lists/*

# Copy pre-compiled Provider and Relay binaries into release directories
COPY artifacts/providers /opt/releases/providers/current/providers
COPY artifacts/stv-relay /opt/releases/relay/current/stv-relay

# Copy runtime configurations and entrypoint scripts
COPY runtime/ /opt/runtime/

# Launch streaming environment via supervisor entrypoint
ENTRYPOINT ["/bin/sh", "/opt/runtime/streaming-entry.sh"]
