# Stream TV Catalog Service Local Configuration
# Copy this file to .env when running the service locally.

# Local private HTTP listener address
CATALOG_LISTEN=127.0.0.1:8092

# Local SQLite database path
CATALOG_DB_PATH=data/catalog.sqlite

# Optional bearer token secret for HTTP authorization
# CATALOG_PRIVATE_TOKEN=

# TMDB Read Access Token (v4 auth) for background syncing
# TMDB_READ_ACCESS_TOKEN=

# Maximum logical payload bytes for stored metadata (Default: 128 MB)
CATALOG_MAX_DATA_BYTES=134217728
