# Stream TV Providers Service Local Configuration
# Copy this file to .env when running the service locally.

# Local private HTTP listener address
PROVIDERS_LISTEN=127.0.0.1:8093

# Optional bearer token secret for HTTP authorization
# PROVIDERS_PRIVATE_TOKEN=

# DNS address dialed through the Mullvad VPN tunnel
PROVIDERS_DNS_ADDRESS=1.1.1.1:53

# Mullvad VPN interface name (wg0 on Linux, utun on macOS)
# PROVIDERS_VPN_INTERFACE=
